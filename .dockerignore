bin
pixsy
pixsy.exe
pixsy.exe~
web/node_modules
web/dist

# 文档与任务记录
*.md
docs
tasks

# 部署与构建配置（镜像内用不到）
deploy
Makefile
Dockerfile
docker-compose.yml
.dockerignore
